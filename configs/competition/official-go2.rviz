Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: odom
    Background Color: 36; 40; 43
    Frame Rate: 25
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metres
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Unitree deskewed scans
      Enabled: true
      Topic:
        Value: /utlidar/cloud_deskewed
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Color Transformer: AxisColor
      Axis: Z
      Style: Points
      Size (Pixels): 3
      Decay Time: 6
    - Class: rviz_default_plugins/Odometry
      Name: Unitree body odometry
      Enabled: true
      Topic:
        Value: /utlidar/robot_odom
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Keep: 80
      Position Tolerance: 0.18
      Angle Tolerance: 0.25
      Shape:
        Value: Arrow
        Shaft Length: 0.3
        Head Length: 0.12
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point: {X: 0, Y: 5, Z: 0}
      Pitch: 1.0
      Yaw: 0.8
